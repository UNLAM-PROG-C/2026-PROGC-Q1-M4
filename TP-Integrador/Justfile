# Grupo M4 — Vision AI
# Uso: just <comando>
# Instalacion: winget install Casey.Just

# Muestra esta ayuda por defecto
default:
    @just --list --unsorted

# ─────────────────────────────────────────────────────────────
#  STACK COMPLETO
# ─────────────────────────────────────────────────────────────

# Levanta frontend + backend + rabbitmq, y deploya los workers en k8s
up:
    @echo ">>> Levantando contenedores..."
    docker compose up --build -d frontend backend rabbitmq
    @echo ""
    @echo ">>> Esperando que RabbitMQ este listo..."
    bash scripts/wait-rabbitmq.sh
    @echo ""
    @echo ">>> Construyendo imagen del worker y desplegando en Kubernetes..."
    bash scripts/deploy-workers.sh
    @echo ""
    @echo "  Frontend  → http://localhost:8080"
    @echo "  Backend   → http://localhost:3001"
    @echo "  RabbitMQ  → http://localhost:15672  (admin / admin)"
    @echo "  Workers   → just worker-status"
    @echo ""

# Detiene contenedores y elimina recursos de k8s
down:
    @echo ">>> Eliminando recursos de Kubernetes..."
    -kubectl delete namespace tp-integrador --ignore-not-found
    @echo ">>> Bajando contenedores..."
    docker compose down
    @echo "Todo detenido."

# ─────────────────────────────────────────────────────────────
#  CONTENEDORES INDIVIDUALES
# ─────────────────────────────────────────────────────────────

# Levanta solo el frontend → http://localhost:8080
front:
    docker compose up --build -d frontend
    @echo "Frontend → http://localhost:8080"

# Modo desarrollo del frontend: sincroniza cambios sin rebuild
front-dev:
    docker compose up -d frontend
    docker compose watch frontend

# Reinicia frontend sin rebuild (manual)
front-restart:
    docker compose restart frontend
    @echo "Frontend restarted"

# Levanta solo el backend → http://localhost:3001
back:
    docker compose up --build -d backend
    @echo "Backend → http://localhost:3001"

# Levanta solo RabbitMQ
rabbitmq:
    docker compose up -d rabbitmq
    @echo "RabbitMQ AMQP → localhost:5672 / 30672 (k8s)"
    @echo "RabbitMQ UI   → http://localhost:15672  (admin / admin)"

# ─────────────────────────────────────────────────────────────
#  WORKERS EN KUBERNETES
# ─────────────────────────────────────────────────────────────

# Construye la imagen del worker y la despliega en k8s
worker-up:
    @echo ">>> Construyendo imagen del worker..."
    docker build -t tp-integrador-worker:latest ./worker
    @echo ">>> Desplegando en Kubernetes..."
    bash scripts/deploy-workers.sh
    @echo "Listo. Ver estado: just worker-status"

# Rebuild de la imagen y redeploy (usar cuando cambia el codigo del worker)
worker-rebuild:
    @echo ">>> Rebuild del worker..."
    docker build -t tp-integrador-worker:latest ./worker
    -kubectl delete jobs --all -n tp-integrador
    bash scripts/deploy-workers.sh
    @echo "Worker re-desplegado."

# Elimina todos los recursos del worker en k8s
worker-down:
    -kubectl delete namespace tp-integrador --ignore-not-found
    @echo "Workers eliminados de Kubernetes."

# Muestra el estado de pods y jobs en k8s
worker-status:
    @echo "=== Pods / Jobs ==="
    kubectl get all -n tp-integrador
    @echo ""
    @echo "=== ScaledJob (KEDA) ==="
    kubectl get scaledjob -n tp-integrador

# Logs de los pods worker activos
worker-logs:
    kubectl logs -l app=tp-worker -n tp-integrador --tail=100 -f

# ─────────────────────────────────────────────────────────────
#  KUBERNETES / KEDA — SETUP INICIAL (solo la primera vez)
# ─────────────────────────────────────────────────────────────

# Instala KEDA en el cluster de Docker Desktop (solo la primera vez)
install-keda:
    @echo ">>> Instalando KEDA..."
    kubectl apply --server-side -f https://github.com/kedacore/keda/releases/download/v2.14.0/keda-2.14.0.yaml
    @echo ">>> Esperando que KEDA este listo (puede tardar ~60s)..."
    kubectl rollout status deployment/keda-operator -n keda --timeout=120s
    kubectl rollout status deployment/keda-metrics-apiserver -n keda --timeout=120s
    @echo "KEDA instalado correctamente."
    
# ─────────────────────────────────────────────────────────────
#  OBSERVABILIDAD
# ─────────────────────────────────────────────────────────────

# Vista completa del sistema: estado k8s + ultimas lineas de cada servicio
log:
    @echo "════════════════════════════════════════════════════════"
    @echo "  ESTADO KUBERNETES"
    @echo "════════════════════════════════════════════════════════"
    -kubectl get all -n tp-integrador
    @echo ""
    -kubectl get scaledjob -n tp-integrador
    @echo ""
    @echo "════════════════════════════════════════════════════════"
    @echo "  LOGS DOCKER (ultimas 30 lineas por servicio)"
    @echo "════════════════════════════════════════════════════════"
    @echo "--- frontend ---"
    -docker compose logs --tail=30 frontend
    @echo ""
    @echo "--- backend ---"
    -docker compose logs --tail=30 backend
    @echo ""
    @echo "--- rabbitmq ---"
    -docker compose logs --tail=30 rabbitmq
    @echo ""
    @echo "════════════════════════════════════════════════════════"
    @echo "  LOGS WORKERS k8s (ultimas 30 lineas)"
    @echo "════════════════════════════════════════════════════════"
    -kubectl logs -l app=worker -n tp-integrador --tail=30

# Logs en tiempo real de todos los contenedores docker
logs:
    docker compose logs -f

#Kubernetes nativamente no tiene un “follow future pods”, no es posible seguir en vivo los logs de los worker.
logs-worker:
    kubectl logs -f -l app=worker -n tp-integrador --prefix=true

# Logs solo del backend
logs-back:
    docker compose logs -f backend

# ─────────────────────────────────────────────────────────────
#  BUILD / LIMPIEZA
# ─────────────────────────────────────────────────────────────

# Reconstruye todas las imagenes docker desde cero
build:
    docker compose build --no-cache

# Elimina contenedores, volumenes, recursos k8s e imagenes del proyecto
clean:
    @echo ">>> [1/4] Eliminando recursos de Kubernetes..."
    -kubectl delete namespace tp-integrador --ignore-not-found
    @echo ">>> [2/4] Bajando contenedores y volumes..."
    docker compose down --volumes --remove-orphans
    @echo ">>> [3/4] Eliminando imagenes del proyecto..."
    -docker rmi tp-integrador-worker:latest --force
    -docker rmi tp-integrador-frontend:latest --force
    -docker rmi tp-integrador-backend:latest --force
    @echo ">>> [4/4] Limpiando cache de builds huerfanos..."
    docker image prune -f
    @echo ""
    @echo "Limpieza completa. Imagenes restantes:"
    docker images